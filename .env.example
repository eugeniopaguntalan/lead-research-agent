# ============================================================
# DEMO MODE - Perfect for Portfolio/Testing (No API Keys!)
# ============================================================
# Set DEMO_MODE=true to run without any API keys.
# Uses mock data and services for demonstration purposes.
# Uncomment the line below to enable:
# DEMO_MODE=true

# ============================================================
# PRODUCTION CONFIGURATION (Required when DEMO_MODE=false)
# ============================================================

# OpenAI API Key
# Required for AI-powered features (not needed in demo mode)
OPENAI_API_KEY=sk-...

# Brave Search API Key
# Required for real web searches (not needed in demo mode)
BRAVE_API_KEY=...

# Neon Postgres Database URL
# Required for production database (demo mode uses SQLite)
DATABASE_URL=postgresql://...

# Resend API Key (for email reports)
# Required for sending email reports (not needed in demo mode)
RESEND_API_KEY=re_...

# Report recipient email address
# Required for email delivery (not needed in demo mode)
REPORT_RECIPIENT_EMAIL=founder@example.com

# ============================================================
# GENERAL CONFIGURATION
# ============================================================

# Node environment (development, production, or test)
NODE_ENV=development
